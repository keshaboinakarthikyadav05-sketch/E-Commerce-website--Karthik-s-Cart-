# Shopora Environment Configuration

# Flask Secret Keys
SECRET_KEY=shopora-super-secret-jwt-key-development-2026
JWT_SECRET_KEY=shopora-jwt-secret-key-development-2026

# PostgreSQL Database Connection
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopora_db

# Razorpay Test Credentials
# Get your test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_shopora12345
RAZORPAY_KEY_SECRET=shopora_razorpay_secret_key_98765

# Server Port
PORT=5000
FLASK_ENV=development
