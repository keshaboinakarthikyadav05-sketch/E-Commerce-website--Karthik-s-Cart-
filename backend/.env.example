# Local development defaults. Copy to backend/.env.
FLASK_ENV=development
DATABASE_URL=sqlite:///shopora.db
SEED_DEMO_USERS=false

# Optional locally; production must use strong, unique values.
SECRET_KEY=
JWT_SECRET_KEY=

# Set these only if you explicitly enable development demo accounts.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=

# Optional Razorpay test credentials from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PORT=5000
